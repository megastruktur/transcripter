# Transcripter server environment — copy to .env and fill in.
# .env is git-ignored; never commit real tokens, keys, or personal paths.

# REQUIRED. Bearer token the API and clients use (generate e.g. via
# `openssl rand -hex 32`).
TRANSCRIPTER_TOKEN=

# Host path for exported transcript notes (worker bind-mounts it to
# /transcripts). Unset/empty falls back to ./storage/transcripts.
# NOTE: the dir must exist on the host BEFORE `docker compose up` — docker
# creates it root-owned otherwise. Point it at your Obsidian vault, e.g.:
# TRANSCRIPTS_DIR=/mnt/your-nas/vault/Transcripts
# Boot-race guard: with transcripts.sentinel set in config.yaml, create the
# marker inside the dir: touch "$TRANSCRIPTS_DIR/.transcripter"
TRANSCRIPTS_DIR=

# Optional: API key for an OpenAI-compatible STT endpoint (referenced from
# config.yaml transcribe.api_key_env). Empty for a local unauthenticated one.
SPEACHES_API_KEY=

# Optional: LinTO diarization endpoint override (wins over config.yaml
# diarization.endpoint when the service lives in a separate stack/host).
# DIARIZATION_ENDPOINT=http://<voice-host>:8070
# Optional: key for the summarize stage's OpenAI-compatible endpoint
# (referenced from config.yaml summarize.api_key_env). On the megaserver this
# is a LiteLLM virtual key scoped to the summarize model — generate via
# POST /key/generate on the proxy, never the master key.

# Required ONLY when enabling the `graph` compose profile (Neo4j backend
# for the `enrich` pipeline stage). Compose interpolates this into
# `NEO4J_AUTH=neo4j/<value>` at parse time and refuses to start neo4j
# without it (`:?` modifier). Leave unset to keep the graph layer off —
# the enrich stage then reports `skipped` (best-effort, like diarize).
# Generate with `openssl rand -hex 24` (or your password manager).
NEO4J_PASSWORD=
