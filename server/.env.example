# Transcripter server environment — copy to .env and fill in.
# .env is git-ignored; never commit real tokens, keys, or personal paths.

# REQUIRED. Bearer token the API and clients use (generate e.g. via
# `openssl rand -hex 32`).
TRANSCRIPTER_TOKEN=

# Host path of the Obsidian vault (worker bind-mounts it to /transcripts,
# api mounts it read-only). When set, finished recordings export their note
# folder here nested as YYYY/MM/, the audio FLAC AND the whole meta tree
# (transcript.md, summary.md, segments.json, …) are MOVED from /storage into
# the recording folder's hidden .transcripter/ subdir ({audio.flac, meta/}),
# and digests/ + indexes/ + Dashboard.md live at the root. /storage becomes
# pipeline scratch — regenerate rehydrates the meta tree from the vault
# mirror automatically. Unset/empty = no vault: everything stays under
# ./storage (the legacy layout).
# NOTE: the dir must exist on the host BEFORE `docker compose up` — docker
# creates it root-owned otherwise. Point it at your Obsidian vault, e.g.:
# VAULT_DIR=/mnt/your-nas/vault/Transcripts
# Boot-race guard: with vault.sentinel set in config.yaml, create the
# marker inside the dir: touch "$VAULT_DIR/.transcripter"
VAULT_DIR=
# Durable-home switch, set by compose from this file: "vault" when VAULT_DIR
# is configured (meta + audio move into the vault), "storage" (default) to
# keep the legacy behavior (meta stays in /storage). Compose passes it to
# both api and worker as TRANSCRIPTER_VAULT_MODE; you rarely set it by hand.
TRANSCRIPTER_VAULT_MODE=

# Optional: API key for an OpenAI-compatible STT endpoint (referenced from
# config.yaml transcribe.api_key_env). Empty for a local unauthenticated one.
SPEACHES_API_KEY=

# Optional: LinTO diarization endpoint override (wins over config.yaml
# diarization.endpoint when the service lives in a separate stack/host).
# DIARIZATION_ENDPOINT=http://<voice-host>:8070
# Optional: key for the summarize stage's OpenAI-compatible endpoint
# (referenced from config.yaml summarize.api_key_env). On the megaserver this
# is a LiteLLM virtual key scoped to the summarize model — generate via
# POST /key/generate on the proxy, never the master key.

# Summarize model id for the OpenAI-compatible endpoint (see config.yaml
# summarize). Set to override config.yaml summarize.model without touching
# the mounted config — unset/empty keeps the yaml value effective.
SUMMARIZE_MODEL=

# Required ONLY when enabling the `graph` compose profile (Neo4j backend
# for the `enrich` pipeline stage). Compose interpolates this into
# `NEO4J_AUTH=neo4j/<value>` at parse time and refuses to start neo4j
# without it (`:?` modifier). Leave unset to keep the graph layer off —
# the enrich stage then reports `skipped` (best-effort, like diarize).
# Generate with `openssl rand -hex 24` (or your password manager).
NEO4J_PASSWORD=

# Phase 3.5 — embedding backend overrides (compose passes these to the
# worker; they win over config.yaml graph.embed.* — the SUMMARIZE_MODEL
# pattern). Switch the embedder to an OpenAI-compatible endpoint
# (LiteLLM route / Infinity / Ollama / OpenAI) without editing the
# mounted config:
#   EMBED_BACKEND=http
#   EMBED_BASE_URL=http://litellm:4000/v1
#   EMBED_MODEL=bge-m3
# graph.embed.dimensions must ALSO be set in config.yaml for the http
# backend (remote dimensionality is not knowable offline). Switching the
# backend/model changes the vector space: semantic index files rebuild on
# the next enrich/backfill, and the embed_tau_high/embed_tau_low dedup
# thresholds were calibrated on bge-m3 — recalibrate before relying on
# the prefilter with a different model.
EMBED_BACKEND=
EMBED_BASE_URL=
EMBED_MODEL=
