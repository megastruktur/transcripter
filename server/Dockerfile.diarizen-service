# DiariZen diarization service — part of the transcripter stack.
# BUT-FIT DiariZen: MIT code, CC-BY-NC-4.0 weights (personal self-host).
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git ffmpeg build-essential \
    && rm -rf /var/lib/apt/lists/*

# torch CPU per upstream constraints.txt; PyPI stays the primary index so
# flit_core & friends resolve (pytorch-only --index-url breaks them).
RUN pip install --no-cache-dir torch==2.1.1 torchaudio==2.1.1 \
        --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
        einops h5py joblib librosa numpy==1.26.4 pandas pesq pystoi \
        pyyaml scipy soundfile tabulate toml tqdm accelerate==1.6.0 \
        fastapi uvicorn python-multipart

RUN git clone --depth 1 https://github.com/BUTSpeechFIT/DiariZen /opt/DiariZen
RUN cd /opt/DiariZen && pip install --no-cache-dir -e . \
    && cd pyannote-audio && pip install --no-cache-dir -e . -c ../constraints.txt

# Weights land in HF_HOME (volume-mount `diarizen-hf-cache` to keep them
# across recreates; ~350 MB base / ~1.3 GB large).
ENV HF_HOME=/cache/huggingface \
    DIARIZEN_MODEL=BUT-FIT/diarizen-wavlm-base-s80-md

COPY diarizen-pilot/service.py /opt/service.py
EXPOSE 80
CMD ["uvicorn", "--host", "0.0.0.0", "--port", "80", "--app-dir", "/opt", "service:app"]
