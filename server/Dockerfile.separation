# Speech separation service: pyannote SpeechSeparation (PixIT/ToTaToNet).
# The gated HF model is BAKED IN at build time; runtime needs no HF token.
#
# Build (the token's account must have accepted the model card conditions):
#   docker build -f Dockerfile.separation \
#     --secret id=hf_token,env=HF_TOKEN -t transcripter-separation:0.1.0 .
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf \
    HF_HUB_OFFLINE=1 \
    SEPARATION_MODEL=pyannote/speech-separation-ami-1.0

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg build-essential && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torch==2.7.1 torchaudio==2.7.1 \
    --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    "pyannote.audio[separation]==4.0.4" \
    speechbrain==1.1.1 \
    fastapi uvicorn python-multipart

# Bake the pipeline into the HF cache (/opt/hf): from_pretrained resolves
# the gated repo AND its submodels (segmentation, embedding) into the
# cache. Runtime loads offline from the same cache — no token needed.
RUN --mount=type=secret,id=hf_token \
    export HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || echo '')" && \
    export HF_HUB_OFFLINE=0 && \
    python - <<'EOF'
import os
import torch

# pyannote 4.0.4 passes token=/huggingface_cache_dir= to speechbrain's
# Pretrained.from_hparams, but speechbrain 1.x Pretrained.__init__ rejects
# them (API break between the projects). The HF token travels via the
# HF_TOKEN env var instead, which huggingface_hub picks up on its own.
from speechbrain.inference.interfaces import Pretrained

_orig = Pretrained.from_hparams.__func__

@classmethod
def _patched(cls, *args, **kwargs):
    kwargs.pop("token", None)
    kwargs.pop("revision", None)
    kwargs.pop("huggingface_cache_dir", None)
    # pyannote's run_opts (torch.device) trips speechbrain's own
    # device-type check; drop it and let speechbrain default to CPU.
    kwargs.pop("run_opts", None)
    return _orig(cls, *args, **kwargs)

Pretrained.from_hparams = _patched

from pyannote.audio import Pipeline

p = Pipeline.from_pretrained(
    "pyannote/speech-separation-ami-1.0",
    token=os.environ.get("HF_TOKEN") or None,
)
p.to(torch.device("cpu"))  # force full submodel resolution/download
EOF

COPY separation/main.py /app/main.py
WORKDIR /app
EXPOSE 80
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "80"]
